<%- include('partials/header') %>

<div style="max-width: 400px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
    <h2 style="text-align: center; margin-bottom: 20px; color: var(--secondary);">Вхід до системи</h2>
    <form action="/login" method="POST">
        <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-control" required placeholder="visitor@test.com">
        </div>
        <div class="form-group">
            <label>Пароль</label>
            <input type="password" name="password" class="form-control" required placeholder="123456">
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Увійти</button>
    </form>
    <p style="text-align: center; margin-top: 15px;">
        Немає акаунту? <a href="/register" style="color: var(--primary);">Зареєструватися</a>
    </p>
</div>

<%- include('partials/footer') %>