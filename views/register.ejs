<%- include('partials/header') %>

<div style="max-width: 400px; margin: 0 auto; background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
    <h2 style="text-align: center; margin-bottom: 20px; color: var(--secondary);">Реєстрація</h2>
    <form action="/register" method="POST">
        <div class="form-group">
            <label>Ваше ім'я</label>
            <input type="text" name="name" class="form-control" required>
        </div>
        <div class="form-group">
            <label>Email</label>
            <input type="email" name="email" class="form-control" required>
        </div>
        <div class="form-group">
            <label>Пароль</label>
            <input type="password" name="password" class="form-control" required minlength="6">
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%;">Зареєструватися</button>
    </form>
</div>

<%- include('partials/footer') %>