<%- include('partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px;">
    <h1>Наше меню</h1>
    
    <form action="/menu" method="GET" style="display: flex; gap: 10px;">
        <input type="text" name="q" value="<%= query %>" placeholder="Пошук страви..." class="form-control" style="width: 200px;">
        <button type="submit" class="btn btn-primary">Знайти</button>
    </form>
</div>

<div style="margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap;">
    <a href="/menu" class="btn <%= !selectedCategory ? 'btn-primary' : 'btn-secondary' %>">Всі категорії</a>
    <% categories.forEach(cat => { %>
        <a href="/menu?category=<%= cat.id %>" class="btn <%= selectedCategory == cat.id ? 'btn-primary' : 'btn-secondary' %>">
            <%= cat.name %>
        </a>
    <% }) %>
</div>

<div class="menu-grid">
    <% dishes.forEach(dish => { %>
        <div class="dish-card">
            <img src="<%= dish.image_url || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&q=80' %>" 
                 alt="<%= dish.name %>" 
                 style="width: 100%; height: 200px; object-fit: cover;">
                 
            <div class="dish-info">
                <span style="font-size: 0.8rem; color: #999;"><%= dish.category_name %></span>
                <h3 class="dish-title"><%= dish.name %></h3>
                <p class="dish-desc"><%= dish.description %></p>
                <% if (dish.allergens && dish.allergens !== '-') { %>
                    <p style="font-size: 0.8rem; color: #e74c3c; margin-bottom: 10px;">Алергени: <%= dish.allergens %></p>
                <% } %>
                <div class="dish-price"><%= parseFloat(dish.price).toFixed(0) %> ₴</div>
                <a href="/menu/dish/<%= dish.id %>" class="btn btn-primary">Детальніше</a>
            </div>
        </div>
    <% }) %>
</div>

<% if (dishes.length === 0) { %>
    <p style="text-align: center; margin-top: 40px; color: #666;">За вашим запитом нічого не знайдено.</p>
<% } %>

<%- include('partials/footer') %>